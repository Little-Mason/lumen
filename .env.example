# ---- Database (PostgreSQL 16 + pgvector) ----
DATABASE_URL="postgresql://lumen:lumen@localhost:5432/lumen?schema=public"

# ---- Auth ----
# 生成：openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_COOKIE_NAME="lumen_session"

# ---- Chat model (DeepSeek 兼容 OpenAI 协议；切 OpenAI 只改这三行) ----
AI_BASE_URL="https://api.deepseek.com/v1"
AI_API_KEY=""
AI_MODEL="deepseek-chat"

# ---- Embedding model (DeepSeek 无 embedding 接口，故单独配置) ----
# 国内可换硅基流动 BAAI/bge-m3，维度需同步改为 1024 并重建向量列
EMBEDDING_BASE_URL="https://api.openai.com/v1"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM="1536"

# ---- Limits & observability ----
AI_RATE_LIMIT_PER_MIN="20"
AI_MONTHLY_BUDGET_CENTS="3000"
SENTRY_DSN=""

# ---- Public ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Optional: Redis 限流（本地 docker compose 已起） ----
REDIS_URL="redis://localhost:6379"
